+/**
+ * ixgbe_check_link_vep1400 - Determine VEP1400 copper link state
+ * @hw: pointer to hardware structure
+ * @speed: pointer to link speed
+ * @link_up: true when link is up
+ * @link_up_wait_to_complete: unused
+ *
+ * The port's SerDes to 88E6190 port 9 (LAN 0) or 10 (LAN 1) stays up
+ * regardless of cabling, so report link only while that uplink and at
+ * least one front-panel copper port (1-6) are up.
+ **/
+static int ixgbe_check_link_vep1400(struct ixgbe_hw *hw,
+				    ixgbe_link_speed *speed, bool *link_up,
+				    __always_unused bool link_up_wait_to_complete)
+{
+	u32 gssr = hw->phy.phy_semaphore_mask | IXGBE_GSSR_TOKEN_SM |
+		   IXGBE_GSSR_PHY0_SM;
+	int uplink = hw->bus.lan_id ? 0x0a : 0x09;
+	int port, val;
+
+	*link_up = false;
+	*speed = IXGBE_LINK_SPEED_UNKNOWN;
+
+	val = ixgbe_mii_bus_read_generic_c22(hw, uplink,
+					     VEP1400_SW_PORT_STATUS, gssr);
+	if (val < 0 || !(val & VEP1400_SW_PORT_LINK))
+		return 0;
+
+	for (port = 1; port <= 6; port++) {
+		val = ixgbe_mii_bus_read_generic_c22(hw, port,
+						     VEP1400_SW_PORT_STATUS,
+						     gssr);
+		if (val >= 0 && (val & VEP1400_SW_PORT_LINK)) {
+			*link_up = true;
+			*speed = IXGBE_LINK_SPEED_2_5GB_FULL;
+			break;
+		}
+	}
+
+	return 0;
+}
