+/**
+ * ixgbe_vep1400_mii_ioctl - Clause 22 access to the VEP1400 switch
+ * @hw: pointer to hardware structure
+ * @mii: MII ioctl data
+ * @cmd: SIOCGMIIREG or SIOCSMIIREG
+ *
+ * The 88E6190 switch sits on the X553 MDIO bus shared by all functions and
+ * is managed by vep1400-mdio-tool at arbitrary Clause 22 PHY addresses.
+ **/
+static int ixgbe_vep1400_mii_ioctl(struct ixgbe_hw *hw,
+				   struct mii_ioctl_data *mii, int cmd)
+{
+	u32 gssr = hw->phy.phy_semaphore_mask | IXGBE_GSSR_TOKEN_SM |
+		   IXGBE_GSSR_PHY0_SM;
+	int val;
+
+	if (mii->phy_id >= PHY_MAX_ADDR || mii->reg_num > 0x1f)
+		return -EINVAL;
+
+	if (cmd == SIOCSMIIREG)
+		return ixgbe_mii_bus_write_generic_c22(hw, mii->phy_id,
+						       mii->reg_num, mii->val_in,
+						       gssr);
+
+	val = ixgbe_mii_bus_read_generic_c22(hw, mii->phy_id, mii->reg_num,
+					     gssr);
+	if (val < 0)
+		return val;
+	mii->val_out = val;
+	return 0;
+}
